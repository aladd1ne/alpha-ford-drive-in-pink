#!/bin/bash

# Prefer Compose v2 ("docker compose"), fall back to the legacy standalone binary.
if docker compose version >/dev/null 2>&1; then
    compose=(docker compose)
elif command -v docker-compose >/dev/null 2>&1; then
    compose=(docker-compose)
else
    echo "Docker is not available. Start Docker Desktop (WSL integration enabled) and retry." >&2
    exit 1
fi

env UID=$(id -u) GID=$(id -g) "${compose[@]}" "$@"
