{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Tableau de bord{% endblock %}

{% block main %}
    <div class="dp-admin-stats">
        {% for experience in experiences %}
            <div class="dp-admin-stat">
                <div class="dp-admin-stat__label">{{ experience.label }}</div>
                <div class="dp-admin-stat__value">{{ counts[experience.value]|default(0) }}</div>
                <div class="dp-admin-stat__note">{{ experience.hasSlots ? 'créneaux réservés' : 'demandes de rappel' }}</div>
            </div>
        {% endfor %}
    </div>

    <a href="{{ ea_url().setController('App\\Controller\\Admin\\ReservationCrudController').setAction('index') }}" class="btn btn-primary">
        Voir toutes les réservations
    </a>
{% endblock %}
