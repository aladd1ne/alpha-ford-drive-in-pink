{% extends '@EasyAdmin/page/content.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block page_title %}Modifier la réservation n°{{ reservation.id }}{% endblock %}

{% block main %}
    <p class="text-muted">
        {{ reservation.experience.label }}
        {% if reservation.slotBooking %}
            · changer la date, le véhicule ou le créneau réserve une place libre et libère l’ancienne.
        {% else %}
            · attribuez une date et le véhicule, puis validez la demande depuis la liste.
        {% endif %}
    </p>

    <div class="card" style="max-width: 640px">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_errors(form) }}
                {{ form_row(form.fullName) }}
                {{ form_row(form.phone) }}
                {{ form_row(form.email) }}
                {{ form_row(form.date) }}
                {% if form.slot is defined %}{{ form_row(form.slot) }}{% endif %}
                {{ form_row(form.vehicle) }}
                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Enregistrer</button>
                    <a href="{{ backUrl }}" class="btn btn-secondary">Annuler</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
