{% extends '@EasyAdmin/layout.html.twig' %}

{% block content_title %}Clients{% endblock %}

{% block main %}
<div class="ea-main-content">
    <div class="dash-wrap">

        <div class="dash-card dash-card--full">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem">
                <h3 class="dash-card-title" style="margin:0">{{ customers|length }} client{{ customers|length > 1 ? 's' : '' }} enregistrés</h3>
            </div>

            {% if customers is empty %}
                <p style="color:var(--text-3);font-size:.9rem">Aucune réservation enregistrée pour l'instant.</p>
            {% else %}
            <div class="table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Téléphone</th>
                            <th>E-mail</th>
                            <th class="text-right">Réservations</th>
                            <th class="text-right">Total dépensé</th>
                            <th>Première résa</th>
                            <th>Dernière résa</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for c in customers %}
                        <tr>
                            <td class="font-medium">{{ c.customerName }}</td>
                            <td>{{ c.phone }}</td>
                            <td>
                                <a href="mailto:{{ c.email }}" class="table-link">{{ c.email }}</a>
                            </td>
                            <td class="text-right">
                                <span class="badge-count">{{ c.bookingCount }}</span>
                            </td>
                            <td class="text-right font-medium accent-text">
                                {{ c.totalSpent|number_format(0) }} TND
                            </td>
                            <td class="text-muted">{{ c.firstBooking|date('d/m/Y') }}</td>
                            <td class="text-muted">{{ c.lastBooking|date('d/m/Y') }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}
        </div>

    </div>
</div>
{% endblock %}
