{# Custom confirmation modal of a row action form (replaces the browser's confirm()),
   opened by a [data-modal-open] button of the same form, see public/js/admin-modal.js.
     id                dialog id
     title             modal title
     message           optional text under the title
     cash_in           true: shows the fixed amount credited to the cagnotte
                       (FundContribution::TEST_DRIVE_AMOUNT: client's share + Alpha Ford's)
     cash_in_optional  true: that cash-in is a "cash_in" checkbox, ticked by default
                       (unticked, only the booking is confirmed)
     submit_label / submit_icon #}
{% set total = constant('App\\Entity\\FundContribution::TEST_DRIVE_AMOUNT') %}
{% set client_share = constant('App\\Entity\\FundContribution::CLIENT_SHARE') %}
{% set alpha_ford_share = constant('App\\Entity\\FundContribution::ALPHA_FORD_SHARE') %}
{% set split = total ~ ' DT (' ~ client_share ~ ' DT client + ' ~ alpha_ford_share ~ ' DT Alpha Ford)' %}
<dialog id="{{ id }}" class="dp-modal-dialog" aria-labelledby="{{ id }}-title">
    <p class="dp-modal-dialog__title" id="{{ id }}-title">{{ title }}</p>
    {% if message|default('') %}<p class="dp-modal-dialog__message">{{ message }}</p>{% endif %}
    {% if cash_in|default(false) %}
        {% if cash_in_optional|default(false) %}
            <div class="form-check">
                <input type="checkbox" id="{{ id }}-cash-in" name="cash_in" value="1" class="form-check-input" checked data-default-checked>
                <label class="form-check-label" for="{{ id }}-cash-in">Encaisser aussi le test drive : cagnotte créditée de {{ split }}</label>
            </div>
        {% else %}
            <p class="dp-modal-dialog__help">Cagnotte créditée de {{ split }}.</p>
        {% endif %}
    {% endif %}
    <div class="dp-modal-dialog__actions">
        <button type="button" class="btn btn-secondary" data-modal-close>Annuler</button>
        <button type="submit" class="btn btn-primary">{% if submit_icon|default('') %}<i class="{{ submit_icon }}"></i> {% endif %}{{ submit_label|default('Confirmer') }}</button>
    </div>
</dialog>
