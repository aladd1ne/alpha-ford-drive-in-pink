{# "Test drive effectué": POST form with a CSRF token (EasyAdmin's form actions have none). #}
{# @var action \EasyCorp\Bundle\EasyAdminBundle\Dto\ActionDto #}
{# @var entity \EasyCorp\Bundle\EasyAdminBundle\Dto\EntityDto #}
<form action="{{ action.linkUrl }}" method="post" class="d-inline dp-validate-test-drive"
      onsubmit="return confirm('Confirmer que {{ entity.instance.fullName|e('js') }} a effectué son test drive ? 30 DT seront ajoutés à la cagnotte.');">
    <input type="hidden" name="_token" value="{{ csrf_token('validate-test-drive-' ~ entity.instance.id) }}">
    <input type="hidden" name="_return" value="{{ app.request.requestUri }}">
    <button type="submit" class="btn btn-sm btn-primary">
        <i class="fas fa-check"></i> <span class="action-label">{{ action.label|trans }}</span>
    </button>
</form>
