{# "Encaisser": amount received + POST with a CSRF token (EasyAdmin's form actions have none). #}
{# @var action \EasyCorp\Bundle\EasyAdminBundle\Dto\ActionDto #}
{# @var entity \EasyCorp\Bundle\EasyAdminBundle\Dto\EntityDto #}
<form action="{{ action.linkUrl }}" method="post" class="d-inline-flex align-items-center gap-1 dp-validate-test-drive"
      onsubmit="return confirm('Encaisser ' + this.amount.value + ' DT pour {{ entity.instance.fullName|e('js') }} ? Le test drive sera validé et la cagnotte créditée.');">
    <input type="hidden" name="_token" value="{{ csrf_token('validate-test-drive-' ~ entity.instance.id) }}">
    <input type="hidden" name="_return" value="{{ app.request.requestUri }}">
    <input type="number" name="amount" value="10" min="0" max="10000" step="1" required
           class="form-control form-control-sm" style="width: 5.5rem" aria-label="Montant reçu (DT)" title="Montant reçu (DT)">
    <span class="small text-muted">DT</span>
    <button type="submit" class="btn btn-sm btn-primary">
        <i class="fas fa-cash-register"></i> <span class="action-label">{{ action.label|trans }}</span>
    </button>
</form>
