{# "Encaisser": opens a modal asking for the amount received (prefilled with the usual client
   share, the client may give more), then POSTs it with a CSRF token (EasyAdmin's form
   actions have none). #}
{# @var action \EasyCorp\Bundle\EasyAdminBundle\Dto\ActionDto #}
{# @var entity \EasyCorp\Bundle\EasyAdminBundle\Dto\EntityDto #}
{% set dialog_id = 'dp-modal-' ~ action.name ~ '-' ~ entity.instance.id %}
<form action="{{ action.linkUrl }}" method="post" class="d-inline dp-validate-test-drive">
    <input type="hidden" name="_token" value="{{ csrf_token('validate-test-drive-' ~ entity.instance.id) }}">
    <input type="hidden" name="_return" value="{{ app.request.requestUri }}">
    <button type="button" class="btn btn-sm btn-primary" data-modal-open="{{ dialog_id }}">
        <i class="fas fa-cash-register"></i> <span class="action-label">{{ action.label|trans }}</span>
    </button>
    {{ include('admin/action/_modal.html.twig', {
        id: dialog_id,
        title: 'Encaisser le test drive de ' ~ entity.instance.fullName,
        message: 'Le test drive sera validé et la cagnotte créditée.',
        amount: true,
        submit_label: 'Encaisser',
        submit_icon: 'fas fa-cash-register',
    }) }}
</form>
