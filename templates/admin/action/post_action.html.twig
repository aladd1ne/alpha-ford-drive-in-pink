{# Row action sent as a POST with a CSRF token (EasyAdmin's link actions are GET).
   Html attributes of the action: data-csrf (token id prefix, + entity id), data-confirm
   (optional question, "%name%" is replaced by the client's name). #}
{# @var action \EasyCorp\Bundle\EasyAdminBundle\Dto\ActionDto #}
{# @var entity \EasyCorp\Bundle\EasyAdminBundle\Dto\EntityDto #}
{% set attributes = action.htmlAttributes %}
{% set question = attributes['data-confirm']|default('')|replace({'%name%': entity.instance.fullName}) %}
<form action="{{ action.linkUrl }}" method="post" class="d-inline dp-row-action dp-row-action--{{ action.name }}"
      {% if question %}onsubmit="return confirm('{{ question|e('js') }}');"{% endif %}>
    <input type="hidden" name="_token" value="{{ csrf_token(attributes['data-csrf'] ~ entity.instance.id) }}">
    <input type="hidden" name="_return" value="{{ app.request.requestUri }}">
    <button type="submit" class="{{ action.cssClass|default('btn btn-sm btn-secondary') }}">
        {% if action.icon %}<i class="{{ action.icon }}"></i>{% endif %} <span class="action-label">{{ action.label|trans }}</span>
    </button>
</form>
