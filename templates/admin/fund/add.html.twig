{% extends '@EasyAdmin/page/content.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block page_title %}Ajouter un montant à la cagnotte{% endblock %}

{% block main %}
    <p class="text-muted">Cagnotte actuelle : <strong>{{ total|number_format(0, ',', ' ') }} DT</strong>. Le montant ajouté apparaît tout de suite sur le site, dans « autres contributions ».</p>

    <div class="card" style="max-width: 640px">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_errors(form) }}
                {{ form_row(form.amount) }}
                {{ form_row(form.note) }}
                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary"
                            onclick="const amount = this.form.querySelector('[name$=&quot;[amount]&quot;]').value; return !amount || confirm('Ajouter ' + amount + ' DT à la cagnotte ?');">
                        <i class="fas fa-plus"></i> Ajouter
                    </button>
                    <a href="{{ backUrl }}" class="btn btn-secondary">Annuler</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
