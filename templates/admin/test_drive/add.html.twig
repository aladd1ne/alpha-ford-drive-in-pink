{% extends '@EasyAdmin/page/content.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block page_title %}Ajouter un test drive{% endblock %}

{% block main %}
    <p class="text-muted">Client venu sans réservation : le test drive est enregistré pour aujourd’hui ({{ today|date('d/m/Y') }}), sans créneau.</p>

    <div class="card" style="max-width: 640px">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_errors(form) }}
                {{ form_row(form.fullName) }}
                {{ form_row(form.phone) }}
                {{ form_row(form.email) }}
                {{ form_row(form.experience) }}
                {{ form_row(form.vehicle) }}
                {{ form_row(form.completed) }}
                {{ form_row(form.amount) }}
                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-plus"></i> Ajouter</button>
                    <a href="{{ backUrl }}" class="btn btn-secondary">Annuler</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
