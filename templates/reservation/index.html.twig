{% extends 'base.html.twig' %}

{% block title %}Réserver mon essai{% endblock %}

{% block body %}
{% set cards = [
    {
        experience: 'everest-ranger',
        dates: '9 & 10 octobre',
        title: 'Everest & Ranger Experience',
        text: 'Ranger Raptor, Ranger Wildtrak, Ranger XLT BVA, Everest Limited ou Everest XLT : choisissez votre modèle et votre créneau.',
        cta: 'Réserver',
    },
    {
        experience: 'territory',
        dates: '23 & 24 octobre',
        title: 'Territory Experience',
        text: 'Deux journées familiales autour du Ford Territory : choisissez votre date et votre créneau.',
        cta: 'Réserver',
    },
    {
        experience: 'octobre',
        dates: 'Tout le mois d’octobre',
        title: 'Autres jours d’octobre',
        text: 'Indiquez la date et le modèle souhaités : un conseiller Alpha Ford vous contacte pour confirmer le rendez-vous.',
        cta: 'Faire une demande',
    },
] %}
<main class="dp-page">
    <div class="dp-container">
        <div class="dp-sec-head">
            <p class="dp-subhead">Réservation</p>
            <div>
                <h1 class="dp-sec-head__title" data-reveal-text>Choisissez votre test drive</h1>
            </div>
        </div>

        <div class="dp-res-grid" data-reveal-stagger>
            {% for card in cards %}
                <article class="dp-res-card">
                    {% if car_images[card.experience] is defined %}
                        <div class="dp-visual dp-res-card__visual">
                            {% include '_car_visual.html.twig' with {experience: card.experience} only %}
                        </div>
                    {% endif %}
                    <p class="dp-event__date">{{ card.dates }}</p>
                    <h2 class="dp-event__title">{{ card.title }}</h2>
                    <p class="dp-event__text">{{ card.text }}</p>
                    {% if full[card.experience] %}
                        <button type="button" class="dp-btn dp-btn--full dp-btn--lg" disabled>Complet</button>
                    {% elseif closed[card.experience] is defined %}
                        <a href="{{ path('reservation_form', {experience: card.experience}) }}" data-closed-message="{{ closed[card.experience] }}" class="dp-btn dp-btn--main dp-btn--lg">
                            {{ card.cta }} <span class="dp-btn__arrow" aria-hidden="true">↗</span>
                        </a>
                    {% else %}
                        <a href="{{ path('reservation_form', {experience: card.experience}) }}" class="dp-btn dp-btn--main dp-btn--lg">
                            {{ card.cta }} <span class="dp-btn__arrow" aria-hidden="true">↗</span>
                        </a>
                    {% endif %}
                </article>
            {% endfor %}
        </div>
    </div>
</main>
{% endblock %}
