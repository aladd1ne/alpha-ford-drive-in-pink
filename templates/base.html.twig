<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Drive in Pink{% endblock %} — Alpha Ford</title>
    <meta name="description" content="Drive in Pink : en octobre, chaque test drive chez Alpha Ford ajoute 30 DT à la cagnotte solidaire Octobre Rose.">
    <meta name="theme-color" content="#FFFFFF">
    <link rel="icon" type="image/png" href="{{ asset('assets/images/favicon.png') }}">
    <link rel="apple-touch-icon" href="{{ asset('assets/images/apple-touch-icon.png') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Onest:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/front.css') }}">
    {# Scroll animations: hide the elements to reveal before first paint; never leave them hidden (see js/scroll-animations.js) #}
    <script>
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.documentElement.classList.add('dp-anim');
            setTimeout(() => { if (!window.dpAnimReady) document.documentElement.classList.remove('dp-anim'); }, 3000);
        }
    </script>
    {% block stylesheets %}{% endblock %}
</head>
<body>

    <nav class="dp-nav" aria-label="Navigation principale">
        <div class="dp-container dp-nav__inner">
            <a href="{{ path('home') }}" class="dp-logo dp-logo--img">
                <img src="{{ asset('assets/images/logo-nav.png') }}" width="278" height="264" alt="Ford Drive in Pink">
            </a>

            <div class="dp-nav__info">
                <span>Octobre Rose <br> test drive solidaire</span>
                <span>Alpha Ford <br> Tunisie</span>
            </div>

            <div class="dp-nav__links">
                <a href="{{ path('home') }}#evenements" class="dp-nav__link">Événements</a>
                <a href="{{ path('reservation') }}" class="dp-btn dp-btn--main">
                    Réserver <span class="dp-btn__arrow" aria-hidden="true">↗</span>
                </a>
            </div>
        </div>
    </nav>

    {% block body %}{% endblock %}

    <footer class="dp-footer">
        <div class="dp-container">
            <div class="dp-footer__head">
                <a href="{{ path('home') }}" class="dp-logo dp-logo--img dp-logo--footer" data-reveal>
                    <img src="{{ asset('assets/images/logo.png') }}" width="634" height="600" loading="lazy" alt="Ford Drive in Pink">
                </a>
                <h4 class="dp-footer__title" data-reveal-text>
                    Alpha Ford se mobilise pour Octobre Rose.
                    <span>Chaque test drive devient un geste de soutien.</span>
                </h4>
            </div>

            <div class="dp-footer__info" data-reveal-stagger>
                <div>
                    <span class="dp-footer__label">Bénéficiaire</span>
                    <p><mark class="dp-highlight">Service de médecine et de chirurgie de l’Institut Salah Azaïez</mark></p>
                </div>
                <div>
                    <span class="dp-footer__label">Contact</span>
                    <p><a href="tel:{{ app_contact_phone|replace({' ': ''}) }}">{{ app_contact_phone }}</a></p>
                </div>
            </div>

            <div class="dp-footer__bottom" data-reveal>
                <p>
                    © {{ "now"|date("Y") }} Comp'pacte. Tous droits réservés.
                    <span class="dp-footer__credit">Conçu et développé par <strong>Comp'pacte</strong></span>
                </p>
                <div class="dp-footer__links">
                    <a href="{{ path('home') }}">Accueil</a>
                    <a href="{{ path('home') }}#evenements">Événements</a>
                    <a href="{{ path('reservation') }}">Réserver</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="{{ asset('js/vendor/gsap.min.js') }}" defer></script>
    <script src="{{ asset('js/vendor/ScrollTrigger.min.js') }}" defer></script>
    <script src="{{ asset('js/vendor/SplitText.min.js') }}" defer></script>
    <script src="{{ asset('js/scroll-animations.js') }}" defer></script>
    {% block scripts %}{% endblock %}
</body>
</html>
