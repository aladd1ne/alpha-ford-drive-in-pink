{% extends 'base.html.twig' %}

{% block title %}Administration{% endblock %}

{% block body %}
<main class="dp-page">
    <div class="dp-container">
        <div class="dp-login">
            <img class="dp-brand-mark" src="{{ asset('assets/images/logo.png') }}" width="634" height="600" alt="Ford Drive in Pink">
            <p class="dp-subhead">Administration</p>
            <h1 class="dp-sec-head__title dp-login__title">Connexion</h1>

            {% if error %}
                <p class="dp-login__error">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
            {% endif %}

            <form class="dp-form" method="post" action="{{ path('admin_login') }}">
                <div class="dp-field">
                    <label class="dp-label" for="email">E-mail</label>
                    <input type="email" id="email" name="_username" value="{{ last_username }}"
                           class="dp-input" autocomplete="username" required autofocus>
                </div>
                <div class="dp-field">
                    <label class="dp-label" for="password">Mot de passe</label>
                    <input type="password" id="password" name="_password"
                           class="dp-input" autocomplete="current-password" required>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <div class="dp-form__actions">
                    <button type="submit" class="dp-btn dp-btn--main dp-btn--lg">Se connecter</button>
                    <a href="{{ path('home') }}" class="dp-form__back">← Retour au site</a>
                </div>
            </form>
        </div>
    </div>
</main>
{% endblock %}
