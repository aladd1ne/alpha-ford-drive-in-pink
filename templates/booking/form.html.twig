{% extends 'base_legacy.html.twig' %}
{% from 'macros/icons.html.twig' import icon %}

{% block title %}Réserver — {{ category.name }}{% endblock %}
{% block body_class %}booking-page{% endblock %}

{% block body %}
<main class="booking-main">
    <div class="container booking-container">

        {# ── Page header ── #}
        <div class="booking-header">
            <a href="{{ path('experience_show', {slug: category.slug}) }}" class="back-link">
                ← {{ category.name }}
            </a>
            <h1 class="booking-title">Réservez votre place</h1>
        </div>

        {# ── Call-to-call banner ── #}
        <div class="call-banner">
            <div class="call-banner-icon">{{ icon('phone', 'icon') }}</div>
            <div class="call-banner-text">
                <span class="call-banner-label">Vous préférez nous appeler ?</span>
                <a href="tel:{{ app_contact_phone|replace({' ': ''}) }}" class="call-banner-phone">{{ app_contact_phone }}</a>
            </div>
            <div class="call-banner-note">
                Formulaire recommandé — cela nous aide à préparer votre aventure et réserver votre place dans le groupe.
            </div>
        </div>

        <div class="booking-layout">

            {# ── Left: Form ── #}
            <div class="booking-form-col">
                <div class="card">
                    <h2 class="card-title">Vos informations</h2>

                    {{ form_start(form, {attr: {id: 'booking-form', novalidate: 'novalidate'}}) }}

                    <div class="form-group">
                        {{ form_label(form.customerName, null, {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(form.customerName) }}
                        {{ form_errors(form.customerName) }}
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            {{ form_label(form.phone, null, {label_attr: {class: 'form-label'}}) }}
                            {{ form_widget(form.phone) }}
                            {{ form_errors(form.phone) }}
                        </div>
                        <div class="form-group">
                            {{ form_label(form.email, null, {label_attr: {class: 'form-label'}}) }}
                            {{ form_widget(form.email) }}
                            {{ form_errors(form.email) }}
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            {{ form_label(form.preferredDate, null, {label_attr: {class: 'form-label'}}) }}
                            {{ form_widget(form.preferredDate) }}
                            {{ form_errors(form.preferredDate) }}
                        </div>
                        <div class="form-group">
                            {{ form_label(form.peopleCount, null, {label_attr: {class: 'form-label'}}) }}
                            {{ form_widget(form.peopleCount) }}
                            {{ form_errors(form.peopleCount) }}
                        </div>
                    </div>

                    {# Extras — carried over from detail page #}
                    {% if availableExtras|length > 0 %}
                    <div class="form-extras">
                        <h3 class="form-extras-title">Options sélectionnées</h3>
                        {% for extra in availableExtras %}
                        <label class="extra-item" for="form-extra-{{ extra.id }}">
                            <input type="checkbox"
                                   id="form-extra-{{ extra.id }}"
                                   name="extra_ids[]"
                                   class="extra-checkbox"
                                   data-price="{{ extra.price }}"
                                   data-id="{{ extra.id }}"
                                   value="{{ extra.id }}"
                                   {{ extra.id in selectedExtraIds ? 'checked' : '' }}>
                            <span class="extra-check-icon" aria-hidden="true"></span>
                            <span class="extra-name">{{ extra.name }}</span>
                            <span class="extra-price">+{{ extra.price|number_format(0) }} TND</span>
                        </label>
                        {% endfor %}
                    </div>
                    {% endif %}

                    <button type="submit" class="btn btn--accent btn--full btn--submit">
                        Confirmer ma réservation
                    </button>

                    {{ form_end(form) }}
                </div>
            </div>

            {# ── Right: Summary + Payment ── #}
            <div class="booking-summary-col">

                {# Order summary #}
                {% set panelSrc = category.panelImage
                    ? (category.panelImage starts with 'http' ? category.panelImage : asset('images/categories/' ~ category.panelImage))
                    : (category.heroImage
                        ? (category.heroImage starts with 'http' ? category.heroImage : asset('images/categories/' ~ category.heroImage))
                        : asset('images/categories/placeholder.svg')) %}

                <div class="card summary-card">
                    <h2 class="card-title">Récapitulatif</h2>
                    <div class="summary-experience">
                        <div class="summary-img" style="background-image: url('{{ panelSrc }}')"></div>
                        <div>
                            <strong class="summary-name">{{ category.name }}</strong>
                            <span class="summary-teaser">{{ category.teaser }}</span>
                        </div>
                    </div>
                    <div class="summary-line">
                        <span>Prix de base</span>
                        <span id="base-price" data-price="{{ category.basePrice }}">{{ category.basePrice|number_format(0) }} TND / pers.</span>
                    </div>
                    <div class="summary-extras-list" id="summary-extras"></div>
                    <div class="summary-total">
                        <span>Total</span>
                        <span class="total-amount" id="total-price" data-base="{{ category.basePrice }}">{{ category.basePrice|number_format(0) }} TND</span>
                    </div>
                </div>

                {# Payment reassurance #}
                <div class="card payment-card">
                    <div class="payment-icon">{{ icon('credit-card', 'icon icon--lg') }}</div>
                    <h2 class="card-title">Aucun paiement en ligne</h2>
                    <p class="payment-intro">
                        Votre réservation est confirmée <strong>par virement bancaire</strong> — nous vous guidons à chaque étape.
                    </p>

                    <div class="payment-deposit">
                        <span class="deposit-label">Acompte de confirmation</span>
                        <span class="deposit-amount">{{ app_deposit_amount }} TND</span>
                    </div>

                    <div class="bank-details">
                        <div class="bank-row">
                            <span class="bank-label">Banque</span>
                            <span class="bank-value">{{ app_bank_name }}</span>
                        </div>
                        <div class="bank-row">
                            <span class="bank-label">RIB</span>
                            <span class="bank-value bank-rib">{{ app_bank_rib }}</span>
                        </div>
                        <div class="bank-row">
                            <span class="bank-label">SWIFT</span>
                            <span class="bank-value">{{ app_bank_swift }}</span>
                        </div>
                    </div>

                    <div class="payment-note payment-note--prominent">
                        {{ icon('phone', 'icon icon--sm') }}
                        <span>
                            Après le virement, appelez-nous pour confirmer votre place :<br>
                            <a href="tel:{{ app_contact_phone|replace({' ': ''}) }}" class="payment-phone payment-phone--lg">{{ app_contact_phone }}</a>
                        </span>
                    </div>
                </div>

            </div>
        </div>
    </div>
</main>
{% endblock %}

{% block scripts %}
<script src="{{ asset('js/price-calculator.js') }}"></script>
{% endblock %}
