{% extends 'base_legacy.html.twig' %}
{% from 'macros/icons.html.twig' import icon %}

{% block title %}Réservation confirmée — {{ booking.reference }}{% endblock %}
{% block body_class %}confirmation-page{% endblock %}

{% block body %}
<main class="confirmation-main">
    <div class="container confirmation-container">

        {# Success badge #}
        <div class="confirmation-badge">
            {{ icon('check-circle', 'icon icon--xl icon--accent') }}
        </div>

        <h1 class="confirmation-title">Réservation enregistrée !</h1>
        <p class="confirmation-subtitle">Nous avons bien reçu votre demande. Voici votre référence :</p>

        <div class="reference-block">
            <span class="reference-label">Référence</span>
            <span class="reference-code">{{ booking.reference }}</span>
        </div>

        {# Booking summary #}
        <div class="confirmation-grid">

            <div class="card conf-card">
                <h2 class="card-title">Votre réservation</h2>
                <div class="conf-detail">
                    <span class="conf-label">Expérience</span>
                    <span class="conf-value">{{ booking.category.name }}</span>
                </div>
                <div class="conf-detail">
                    <span class="conf-label">Nom</span>
                    <span class="conf-value">{{ booking.customerName }}</span>
                </div>
                <div class="conf-detail">
                    <span class="conf-label">Téléphone</span>
                    <span class="conf-value">{{ booking.phone }}</span>
                </div>
                <div class="conf-detail">
                    <span class="conf-label">E-mail</span>
                    <span class="conf-value">{{ booking.email }}</span>
                </div>
                <div class="conf-detail">
                    <span class="conf-label">Personnes</span>
                    <span class="conf-value">{{ booking.peopleCount }}</span>
                </div>
                <div class="conf-detail">
                    <span class="conf-label">Date souhaitée</span>
                    <span class="conf-value">{{ booking.preferredDate|date('d/m/Y') }}</span>
                </div>

                {% if booking.selectedExtras|length > 0 %}
                <div class="conf-detail conf-detail--extras">
                    <span class="conf-label">Options</span>
                    <ul class="conf-extras-list">
                        {% for extra in booking.selectedExtras %}
                        <li>{{ extra.name }} <span class="extra-price">+{{ extra.price|number_format(0) }} TND</span></li>
                        {% endfor %}
                    </ul>
                </div>
                {% endif %}

                <div class="conf-detail conf-total">
                    <span class="conf-label">Total</span>
                    <span class="conf-value conf-total-amount">{{ booking.totalPrice|number_format(2) }} TND</span>
                </div>
            </div>

            <div class="card payment-card">
                <div class="payment-icon">{{ icon('credit-card', 'icon icon--lg') }}</div>
                <h2 class="card-title">Instructions de paiement</h2>

                <p class="payment-intro">Pour <strong>confirmer définitivement</strong> votre réservation, effectuez un virement bancaire de :</p>

                <div class="payment-deposit">
                    <span class="deposit-label">Acompte</span>
                    <span class="deposit-amount">{{ booking.depositAmount|number_format(0) }} TND</span>
                </div>

                <div class="bank-details">
                    <div class="bank-row">
                        <span class="bank-label">Banque</span>
                        <span class="bank-value">{{ app_bank_name }}</span>
                    </div>
                    <div class="bank-row">
                        <span class="bank-label">RIB</span>
                        <span class="bank-value bank-rib">{{ app_bank_rib }}</span>
                    </div>
                    <div class="bank-row">
                        <span class="bank-label">SWIFT</span>
                        <span class="bank-value">{{ app_bank_swift }}</span>
                    </div>
                    <div class="bank-row">
                        <span class="bank-label">Référence</span>
                        <span class="bank-value">{{ booking.reference }}</span>
                    </div>
                </div>

                <div class="payment-note payment-note--prominent">
                    {{ icon('phone', 'icon icon--sm') }}
                    <span>
                        Après avoir effectué le virement, appelez-nous pour confirmer :<br>
                        <a href="tel:{{ app_contact_phone|replace({' ': ''}) }}" class="payment-phone payment-phone--lg">{{ app_contact_phone }}</a>
                    </span>
                </div>

                <p class="payment-reminder">Indiquez votre référence <strong>{{ booking.reference }}</strong> dans le motif du virement.</p>
            </div>

        </div>

        <div class="confirmation-footer">
            <a href="{{ path('home') }}" class="btn btn--ghost">← Retour à l'accueil</a>
        </div>

    </div>
</main>
{% endblock %}
