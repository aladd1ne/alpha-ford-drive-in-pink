{% extends 'base.html.twig' %}

{% block title %}Drive in Pink — Test drive solidaire{% endblock %}

{% block body %}
{% set models = ['Ford Everest', 'Ford Ranger', 'Ford Territory', 'Octobre Rose', 'Test drive solidaire', '30 DT par essai'] %}
{% set events = [
    {
        experience: 'everest-ranger',
        dates: '9 & 10 octobre',
        day: '09—10 octobre',
        title: 'Everest & Ranger Experience',
        text: 'Découvrez le Ford Everest et le Ford Ranger lors de deux journées de test drive et d’animations Drive in Pink.',
        tags: ['Ford Everest', 'Ford Ranger', 'Test drive'],
    },
    {
        experience: 'territory',
        dates: '23 & 24 octobre',
        day: '23—24 octobre',
        title: 'Territory Experience',
        text: 'Découvrez le Ford Territory lors de deux journées familiales et conviviales, avec des animations pour enfants, des moments de partage et une belle mobilisation solidaire.',
        tags: ['Ford Territory', 'Famille', 'Animations enfants'],
    },
] %}
<main>

    {# ── Hero ── #}
    <header class="dp-hero">
        <div class="dp-container">
            <div class="dp-hero__caption">
                {#
                    Each word slides up from a mask; then a drop of hope falls into "Pink",
                    which fills with Octobre Rose (see .dp-hero__word / .dp-hero__hope in front.css).
                #}
                <h1 class="dp-hero__title" aria-label="Drive in Pink">
                    <span class="dp-hero__word" aria-hidden="true"><span style="--i: 0">Drive</span></span>
                    <span class="dp-hero__word" aria-hidden="true"><span style="--i: 1">in</span></span>
                    <span class="dp-hero__hope" aria-hidden="true"><span class="dp-hero__word"><span class="dp-hero__fill" style="--i: 2">Pink</span></span></span>
                </h1>
                <ul class="dp-hero__pills" aria-label="Campagne">
                    <li class="dp-pill dp-pill--p1">Test drive solidaire</li>
                    <li class="dp-pill dp-pill--dark dp-pill--p2">Octobre Rose</li>
                    <li class="dp-pill dp-pill--main dp-pill--p3">30 DT par essai</li>
                    <li class="dp-pill dp-pill--p4">Alpha Ford</li>
                </ul>
            </div>

            <div class="dp-hero__intro">
                {# ── Fund counter ── #}
                {# Live: kept in sync with the backend by js/fund-live.js #}
                <section class="dp-fund" aria-label="Cagnotte solidaire"
                         data-fund-live="{{ path('fund_state') }}" data-fund-state="{{ fund.toArray|json_encode }}">
                    <p class="dp-subhead">Cagnotte solidaire <span class="dp-live" title="Mise à jour en direct">En direct</span></p>
                    <p class="dp-fund__value" data-count="{{ fund.total }}" data-fund="total">{{ fund.total|number_format(0, ',', ' ') }}<small>DT</small><span class="dp-fund__bump" data-fund-bump aria-hidden="true"></span></p>
                    <p class="dp-fund__meta">
                        <strong data-fund="testDrives">{{ fund.testDrives }}</strong>
                        <span data-fund-label="testDrives" data-one="test drive validé" data-many="test drives validés">{{ fund.testDrives > 1 ? 'test drives validés' : 'test drive validé' }}</span>
                        · <a href="{{ path('fund') }}" class="dp-link">Voir la cagnotte <span aria-hidden="true">↗</span></a>
                    </p>
                    <p class="dp-sr-only" role="status" data-fund-status></p>
                    <ul class="dp-fund__pills">
                        <li class="dp-pill dp-pill--tilt-l">10 DT client</li>
                        <li class="dp-pill dp-pill--dark dp-pill--tilt-r">+ 20 DT Alpha Ford</li>
                        <li class="dp-pill dp-pill--main dp-pill--tilt-l">= 30 DT par essai</li>
                    </ul>
                </section>

                <div class="dp-hero__content">
                    <h2 class="dp-hero__lead">En octobre, chaque essai devient un geste de soutien.</h2>
                    <p class="dp-hero__text">Pour chaque test drive réalisé chez Alpha Ford&nbsp;:</p>
                    <p class="dp-hero__formula">10 DT versés par le client + 20 DT versés par Alpha Ford</p>
                    <p class="dp-hero__text">
                        Soit <strong class="dp-accent">30 DT</strong> ajoutés à la cagnotte solidaire destinée à contribuer
                        à l’acquisition de moniteurs médicaux pour
                        <mark class="dp-highlight">le service de médecine et de chirurgie de l’Institut Salah Azaïez</mark>.
                    </p>
                    <a href="{{ path('reservation') }}" class="dp-btn dp-btn--main dp-btn--lg">
                        Je réserve mon essai <span class="dp-btn__arrow" aria-hidden="true">↗</span>
                    </a>
                </div>
            </div>
        </div>
    </header>

    {# ── Marquee bands ── #}
    <div class="dp-marq" aria-hidden="true">
        <div class="dp-marq__band dp-marq__band--blue">
            <div class="dp-marq__track">
                {% for i in 1..2 %}{% for item in models %}<span class="dp-marq__item">{{ item }}</span>{% endfor %}{% endfor %}
            </div>
        </div>
        <div class="dp-marq__band dp-marq__band--main">
            <div class="dp-marq__track dp-marq__track--reverse">
                {% for i in 1..2 %}{% for item in models|reverse %}<span class="dp-marq__item">{{ item }}</span>{% endfor %}{% endfor %}
            </div>
        </div>
    </div>

    {# ── Cover ── #}
    <section class="dp-cover" aria-label="Test drive solidaire">
        <div class="dp-container">
            <figure class="dp-cover__img" data-reveal="cover">
                <img src="{{ asset('assets/images/cover.jpeg') }}" width="1600" height="620" loading="lazy"
                     alt="Test drive solidaire — Ford Everest, Ford Territory et Ford Ranger XLT sous le ruban rose d’Octobre Rose. Un essai. Un geste. Un impact.">
            </figure>
        </div>
    </section>

    {# ── Events ── #}
    <section class="dp-section dp-events" id="evenements">
        <div class="dp-container">
            <div class="dp-sec-head">
                <p class="dp-subhead" data-reveal>Octobre Rose</p>
                <div>
                    <h2 class="dp-sec-head__title" data-reveal-text>Les rendez-vous Drive in Pink à ne pas manquer</h2>
                    <p class="dp-sec-head__text" data-reveal>
                        Venez découvrir les modèles Ford lors de deux week-ends de test drive et d’animations spéciales
                        organisés dans le cadre d’Octobre Rose.
                    </p>
                </div>
            </div>

            <div class="dp-events__grid" data-reveal-stagger>
                {% for event in events %}
                    <article class="dp-event">
                        <div class="dp-event__img dp-visual">
                            {% include '_car_visual.html.twig' with {experience: event.experience} only %}
                            <span class="dp-event__badge">{{ event.day }}</span>
                            <ul class="dp-event__tags">
                                {% for tag in event.tags %}<li>{{ tag }}</li>{% endfor %}
                            </ul>
                        </div>
                        <p class="dp-event__date">{{ event.dates }}</p>
                        <h3 class="dp-event__title">{{ event.title }}</h3>
                        <p class="dp-event__text">{{ event.text }}</p>
                        {% if full[event.experience] %}
                            <button type="button" class="dp-btn dp-btn--full dp-event__cta" disabled>Complet</button>
                        {% else %}
                            <a data-music-start href="{{ path('reservation_form', {experience: event.experience}) }}" class="dp-btn dp-btn--bord dp-event__cta">
                                Réserver <span class="dp-btn__arrow" aria-hidden="true">↗</span>
                            </a>
                        {% endif %}
                    </article>
                {% endfor %}
            </div>

            <div class="dp-events__note" data-reveal>
                <p>
                    Chaque test drive réalisé et validé durant ces journées, comme pendant tout le mois d’octobre,
                    ajoute <strong class="dp-accent">30 DT</strong> à la cagnotte solidaire destinée à contribuer à
                    l’acquisition de moniteurs médicaux pour <mark class="dp-highlight">le service de médecine et de chirurgie de l’Institut Salah Azaïez</mark>.
                </p>
                <a href="{{ path('reservation') }}" class="dp-btn dp-btn--main dp-btn--lg">
                    Je réserve mon essai <span class="dp-btn__arrow" aria-hidden="true">↗</span>
                </a>
            </div>
        </div>
    </section>

    {# ── Big text marquee ── #}
    <div class="dp-bigmarq" aria-hidden="true" data-reveal>
        <div class="dp-marq__track">
            {% for i in 1..4 %}<span>Drive in Pink</span><span>Octobre Rose</span>{% endfor %}
        </div>
    </div>

</main>
{% endblock %}

{% block scripts %}
    <script src="{{ asset('js/fund-live.js') }}" defer></script>
{% endblock %}
