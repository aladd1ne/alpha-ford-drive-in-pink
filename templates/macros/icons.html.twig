{# Inline SVG icons — Heroicons-style (24×24 viewBox, stroke-based) #}
{% macro icon(name, class) %}
    {%- set c = class ?? 'icon' -%}
    {%- if name == 'clock' -%}
        <svg xmlns="http://www.w3.org/2000/svg" class="{{ c }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    {%- elseif name == 'map-pin' -%}
        <svg xmlns="http://www.w3.org/2000/svg" class="{{ c }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 1 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
    {%- elseif name == 'users' -%}
        <svg xmlns="http://www.w3.org/2000/svg" class="{{ c }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
    {%- elseif name == 'zap' -%}
        <svg xmlns="http://www.w3.org/2000/svg" class="{{ c }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
    {%- elseif name == 'sun' -%}
        <svg xmlns="http://www.w3.org/2000/svg" class="{{ c }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
    {%- elseif name == 'check-circle' -%}
        <svg xmlns="http://www.w3.org/2000/svg" class="{{ c }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
    {%- elseif name == 'shield' -%}
        <svg xmlns="http://www.w3.org/2000/svg" class="{{ c }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
    {%- elseif name == 'car' -%}
        <svg xmlns="http://www.w3.org/2000/svg" class="{{ c }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 5v3h-4m-2 0H5m0 0a2 2 0 1 0 4 0 2 2 0 0 0-4 0m10 0a2 2 0 1 0 4 0 2 2 0 0 0-4 0"/></svg>
    {%- elseif name == 'package' -%}
        <svg xmlns="http://www.w3.org/2000/svg" class="{{ c }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><line x1="16.5" y1="9.4" x2="7.5" y2="4.21"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
    {%- elseif name == 'droplet' -%}
        <svg xmlns="http://www.w3.org/2000/svg" class="{{ c }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
    {%- elseif name == 'shirt' -%}
        <svg xmlns="http://www.w3.org/2000/svg" class="{{ c }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.57a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.57a2 2 0 0 0-1.34-2.23z"/></svg>
    {%- elseif name == 'footprints' -%}
        <svg xmlns="http://www.w3.org/2000/svg" class="{{ c }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 16v-2.38C4 11.5 2.97 10.43 3 8c.07-2.5 1.95-4 4-4s4 1.5 4 4 c.03 2.43-1 3.5-1 5.62V16"/><path d="M20 16v-2.38c0-2.12-1.03-3.19-1-5.62.07-2.5 1.95-4 4-4"/><path d="M4 18c0 1.1.9 2 2 2h12a2 2 0 0 0 2-2v-2H4v2z"/></svg>
    {%- elseif name == 'bag' -%}
        <svg xmlns="http://www.w3.org/2000/svg" class="{{ c }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
    {%- elseif name == 'utensils' -%}
        <svg xmlns="http://www.w3.org/2000/svg" class="{{ c }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><line x1="3" y1="2" x2="3" y2="22"/><path d="M7 2v4a5 5 0 0 1-4 5v9"/><line x1="7" y1="2" x2="7" y2="22"/><path d="M21 15V2v0a5 5 0 0 0-5 5v6h5Zm0 0v7"/></svg>
    {%- elseif name == 'calendar' -%}
        <svg xmlns="http://www.w3.org/2000/svg" class="{{ c }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
    {%- elseif name == 'credit-card' -%}
        <svg xmlns="http://www.w3.org/2000/svg" class="{{ c }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
    {%- elseif name == 'phone' -%}
        <svg xmlns="http://www.w3.org/2000/svg" class="{{ c }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.63 3.4 2 2 0 0 1 3.6 1.21h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6 6l.93-.93a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 16z"/></svg>
    {%- elseif name == 'heart' -%}
        <svg xmlns="http://www.w3.org/2000/svg" class="{{ c }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
    {%- else -%}
        <svg xmlns="http://www.w3.org/2000/svg" class="{{ c }}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    {%- endif %}
{% endmacro %}
